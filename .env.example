# Copy to .env and fill keys as needed

# OpenAI (required for full chat agent; without it, local planner stub runs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database / Redis (compose or local)
DATABASE_URL=postgresql://chatshoot:chatshoot@localhost:5432/chatshoot
REDIS_URL=redis://localhost:6379

# Media root (absolute path on host when running workers locally)
MEDIA_ROOT=./media

# Replicate — token only. Agent picks model slug; version resolved at runtime.
# Optional REPLICATE_MODEL_VERSION = emergency override if API resolve fails.
REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=

# ElevenLabs / Sarvam — API key only. Agent lists/picks/creates voices at runtime.
# Optional ELEVENLABS_VOICE_ID = last-resort default if voice library empty.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
SARVAM_API_KEY=

# Azure AI Video Indexer (ARM accounts — recommended)
# Overview: Subscription ID, Resource group, Account name, Account ID, Location
# Auth: az login (personal) → worker calls management.azure.com generateAccessToken
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_VIDEO_INDEXER_ACCOUNT_NAME=
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_LOCATION=eastus
# Optional path if az is not on PATH (default: az)
# AZURE_CLI_PATH=/home/YOU/.local/bin/az
# Max wait for upload+index (ms). Default 8 minutes.
# AZURE_VI_MAX_WAIT_MS=480000
# Classic trial only (api-portal key). Unused when ARM vars above are set.
# AZURE_VIDEO_INDEXER_SUBSCRIPTION_KEY=

# Crawl
FIRECRAWL_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# Blender worker (optional). Default: blender on PATH. SVG fallback if missing.
# BLENDER_BIN=blender
# BLENDER_USE_GPU=1

NEXT_PUBLIC_APP_URL=http://localhost:2980
NODE_ENV=development
